<footer class="page-footer bg-color">
    <div class="container row center-align">
        <div class="col s12 m8 l8 copy-right">
            &copy; <span id="CurrentYear"></span> <%- config.author || config.title %>

            <% if (theme.wordCount.enable && theme.wordCount.totalCount) { %>
            &nbsp;<i class="fa fa-area-chart"></i>&nbsp;站点总字数:&nbsp;
            <span class="white-color"><%= totalcount(site) %></span>
            <% } %>
        </div>
        <div class="col s12 m4 l4 social-link"><%- partial('_partial/social-link') %></div>
    </div>
</footer>

<div class="progress-bar"></div>

<script language="javascript">
    function siteTime() {
        var today = new Date();
        document.getElementById("CurrentYear").innerHTML = today.getFullYear();
    }
    siteTime();
</script>
